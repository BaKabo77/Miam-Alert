# Copier ce fichier en .env (jamais commité) et remplacer les valeurs.
# Générer un mot de passe fort : openssl rand -base64 24 | tr -d '/+='

# --- Base de données (service `db`) ---
POSTGRES_USER=miam_alert
POSTGRES_PASSWORD=change-me
POSTGRES_DB=miam_alert

# Hôte `db` = nom du service Docker (pas localhost).
# Encoder en URL les caractères spéciaux du mot de passe s'il y en a.
DATABASE_URL=postgresql://miam_alert:change-me@db:5432/miam_alert?schema=public

# --- Backend ---
NODE_ENV=development
PORT=3000
