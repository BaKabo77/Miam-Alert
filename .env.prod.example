# Variables de PRODUCTION (docker-compose.prod.yml).
# Sur le serveur : copier en .env.prod (jamais commité), puis chmod 600 .env.prod.
# Secrets DIFFÉRENTS de ceux du développement, générés sur le serveur.

# Domaine principal : le front y est servi, l'API sur api.<domaine>.
DOMAIN=miam-alert.fr

POSTGRES_USER=miam_alert
POSTGRES_DB=miam_alert
# Générer : openssl rand -hex 32   (hexadécimal : utilisable tel quel dans l'URL de connexion)
POSTGRES_PASSWORD=change-me

# Générer : openssl rand -base64 48   (l'API refuse de démarrer sous 32 caractères)
JWT_SECRET=change-me

# Facultatif : adresse de surveillance (healthchecks.io) prévenue après la tâche des alertes de 9 h.
# Si elle ne reçoit pas de signal vers 9 h, le service prévient par email. HTTPS uniquement.
ALERTS_HEALTHCHECK_URL=

# Mesure d'audience (Umami, voir deploy/analytics/README.md).
# Mot de passe du rôle umami : openssl rand -hex 32   (hexadécimal : utilisable tel quel dans l'URL)
UMAMI_DB_PASSWORD=change-me
# Secret de session d'Umami : openssl rand -hex 32
UMAMI_APP_SECRET=change-me
# Second mot de passe devant le tableau de bord (Caddy). Empreinte bcrypt générée par :
#   docker run --rm -it caddy:2.11.7-alpine caddy hash-password   (mot de passe demandé, masqué :
#   jamais en clair dans l'historique du terminal)
# Entre APOSTROPHES : l'empreinte contient des « $ » que Docker Compose interpréterait sinon.
STATS_ADMIN_USER=change-me
STATS_ADMIN_HASH='$2a$14$change-me'

# Emails (Brevo, relais SMTP). Identifiant et clé SMTP : espace Brevo, « SMTP & API ».
# La connexion est chiffrée (TLS) obligatoirement en production.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASSWORD=change-me
MAIL_FROM=no-reply@miam-alert.fr
