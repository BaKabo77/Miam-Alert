# Envoi des journaux du serveur vers Backblaze B2 (déclenché par miam-logship.timer).
# Installation : /etc/systemd/system/miam-logship.service
[Unit]
Description=Envoi chiffré des journaux de Miam'Alert hors du serveur
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/miam-logship
# Position atteinte dans chaque journal : /var/lib/miam-logship (créé par systemd, root seul).
StateDirectory=miam-logship
StateDirectoryMode=0700

# Isolation : le script lit les journaux et envoie des fichiers, rien d'autre. Il voit le système en
# lecture seule, n'écrit que dans son dossier d'état et son /tmp privé, n'a AUCUNE capacité root
# (les journaux appartiennent à root : il les lit en tant que propriétaire) et ne peut ouvrir que
# des connexions réseau ordinaires.
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
