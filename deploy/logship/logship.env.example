# Configuration de l'envoi des journaux. Sur le serveur : /etc/miam-logship/logship.env,
# propriétaire root, droits 600 (contient la clé d'accès Backblaze).

# Clé PUBLIQUE age (age1...), la même que pour les sauvegardes. La clé privée ne doit JAMAIS se
# trouver sur le serveur.
AGE_RECIPIENT=age1change-me

# Backblaze B2 : bucket DÉDIÉ aux journaux (Object Lock, 180 jours), et clé d'application limitée à
# ce bucket avec les seuls droits listBuckets et writeFiles (créée avec l'outil b2).
B2_BUCKET=miam-alert-logs-change-me
B2_KEY_ID=keyID-change-me
B2_APPLICATION_KEY=applicationKey-change-me
# Point d'accès S3 de la région du compte (EU Central par défaut).
# B2_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com

# Nom du serveur dans l'arborescence du bucket (prod/AAAA/MM/JJ/...).
SERVER_NAME=prod

# Facultatif : URL de surveillance (healthchecks.io), prévenue à chaque envoi réussi ou raté.
HEALTHCHECK_URL=
