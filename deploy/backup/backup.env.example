# Configuration de la sauvegarde. Sur le serveur : /etc/miam-backup/backup.env,
# propriétaire root, droits 600 (contient la clé d'accès Backblaze).

# Dossier où se trouvent docker-compose.prod.yml et .env.prod.
COMPOSE_DIR=/home/kabo/miam-alert

# Clé PUBLIQUE age (age1...). La clé privée ne doit JAMAIS se trouver sur le serveur.
AGE_RECIPIENT=age1change-me

# Backblaze B2 : clé d'application limitée au bucket, en écriture seule (Write Only).
B2_BUCKET=miam-alert-backups-change-me
RCLONE_CONFIG_B2_ACCOUNT=keyID-change-me
RCLONE_CONFIG_B2_KEY=applicationKey-change-me

# Facultatif : URL de surveillance (healthchecks.io), prévenue à chaque succès ou échec.
HEALTHCHECK_URL=
