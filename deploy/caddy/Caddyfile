# Reverse proxy de production : SEUL point d'entrée depuis Internet (ports 80 et 443).
# Caddy obtient et renouvelle seul les certificats Let's Encrypt, et redirige HTTP vers HTTPS.
# {$DOMAIN} vient de l'environnement (miam-alert.fr en production).
{
	# Pas d'API d'administration : personne ne peut modifier la configuration à chaud.
	admin off
}

(security_headers) {
	header {
		# HSTS : pendant un an, le navigateur refuse de se connecter au domaine et à ses
		# sous-domaines autrement qu'en HTTPS (pas de détournement vers HTTP sur un Wi-Fi piégé).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Ne pas annoncer les logiciels utilisés (Caddy, Nginx).
		-Server
		defer
	}
}

# Le front (application React servie par Nginx).
{$DOMAIN} {
	import security_headers
	reverse_proxy web:8080
}

www.{$DOMAIN} {
	import security_headers
	redir https://{$DOMAIN}{uri} permanent
}

# Mesure d'audience (Umami). Seuls le script de mesure et la réception des visites sont publics :
# tout le reste (tableau de bord, API d'administration) exige en plus un mot de passe vérifié par
# Caddy, AVANT d'atteindre Umami. Le compte par défaut d'Umami (admin / umami, actif au premier
# démarrage) et une éventuelle faille de son interface ne sont donc pas exposés à Internet.
stats.{$DOMAIN} {
	import security_headers
	@tracking path /script.js /api/send
	handle @tracking {
		request_body {
			max_size 16KB
		}
		reverse_proxy stats:3000
	}
	# Le mot de passe de Caddy ne peut pas protéger directement le tableau de bord : le front d'Umami
	# envoie son propre en-tête « Authorization: Bearer » à chaque appel, qui remplace celui du
	# mot de passe (le navigateur le redemanderait sans fin). Il est donc vérifié UNE fois, sur
	# /gate, qui remet un cookie secret ; c'est ce cookie qui ouvre ensuite le tableau de bord.
	handle /gate {
		# route : directives exécutées dans l'ordre écrit. Sans elle, Caddy placerait header et
		# redir AVANT basic_auth, et remettrait le cookie sans vérifier le mot de passe.
		route {
			basic_auth {
				{$STATS_ADMIN_USER} {$STATS_ADMIN_HASH}
			}
			# HttpOnly : illisible par un script ; SameSite=Strict : jamais envoyé depuis un autre
			# site ; 12 h au plus dans le navigateur.
			header Set-Cookie "miam_stats_gate={$STATS_GATE_TOKEN}; Path=/; Max-Age=43200; Secure; HttpOnly; SameSite=Strict"
			header Cache-Control no-store
			redir * / 303
		}
	}
	# Les deux conditions s'appliquent ensemble : valeur identique au secret ET 64 caractères
	# hexadécimaux. Un secret vide ou mal formé ne laisse donc passer personne (échec fermé).
	@gate_open {
		vars {http.request.cookie.miam_stats_gate} {$STATS_GATE_TOKEN}
		vars_regexp {http.request.cookie.miam_stats_gate} ^[0-9a-f]{64}$
	}
	handle @gate_open {
		reverse_proxy stats:3000
	}
	# Sans le cookie : vers la porte (le navigateur demande alors le mot de passe).
	handle {
		redir * /gate 303
	}
}

# L'API. Caddy remplace l'en-tête X-Forwarded-For envoyé par le client par sa vraie IP :
# l'API ne fait confiance qu'à ce proxy (TRUST_PROXY=1).
api.{$DOMAIN} {
	import security_headers
	# Première barrière contre les corps de requête énormes (l'API limite déjà le JSON à 16 ko).
	request_body {
		max_size 64KB
	}
	reverse_proxy api:3000
}
