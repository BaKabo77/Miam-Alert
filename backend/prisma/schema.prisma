// Schéma Prisma de Miam'Alert.

generator client {
  provider = "prisma-client"
  // Client généré dans src/ pour être compilé avec le reste de l'application.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Des enums plutôt que du texte libre : la base elle-même refuse toute valeur inconnue.

enum HouseholdRole {
  OWNER
  MEMBER
}

// DLC : à respecter strictement. DDM : le produit reste consommable après la date.
enum ExpiryType {
  DLC
  DDM
}

enum PantryItemStatus {
  ACTIVE
  CONSUMED
  WASTED
  FROZEN
}

// Quantités en entiers dans l'unité la plus petite (1,5 L = 1500 ML) :
// pas d'erreur d'arrondi et pas de type décimal à manipuler côté code.
enum QuantityUnit {
  PIECE
  GRAM
  MILLILITER
}

// Identifiants en UUID (@db.Uuid = type natif PostgreSQL) : impossibles à deviner,
// contrairement à un id auto-incrémenté (1, 2, 3...) qu'un attaquant pourrait parcourir.

model User {
  id              String    @id @default(uuid()) @db.Uuid
  // 254 = longueur maximale d'une adresse email valide. Stockée en minuscules (fait par le service).
  email           String    @unique @db.VarChar(254)
  // Le hash argon2, jamais le mot de passe. Ce champ ne doit jamais sortir de l'API.
  passwordHash    String
  // Facultatifs (minimisation RGPD) : servent seulement à saluer l'utilisateur et, plus tard,
  // à identifier les membres d'un foyer partagé. Modifiables et effaçables par l'utilisateur.
  firstName       String?   @db.VarChar(100)
  lastName        String?   @db.VarChar(100)
  // Rempli quand l'utilisateur a cliqué sur le lien reçu par email : l'adresse lui appartient.
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships   HouseholdMember[]
  refreshTokens RefreshToken[]
  emailTokens   EmailToken[]
}

model Household {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     HouseholdMember[]
  pantryItems PantryItem[]
  alerts      Alert[]
}

// Table de liaison User <-> Household : un utilisateur peut appartenir à plusieurs foyers
// (V2), et c'est ici qu'on vérifiera l'appartenance avant tout accès (protection IDOR).
model HouseholdMember {
  userId      String        @db.Uuid
  householdId String        @db.Uuid
  role        HouseholdRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  // onDelete: Cascade : supprimer un compte supprime ses appartenances (RGPD : suppression réelle).
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  // Clé primaire composée : un utilisateur ne peut pas être deux fois membre du même foyer.
  @@id([userId, householdId])
  @@index([householdId])
}

// Cache des fiches Open Food Facts, partagé entre tous les foyers (données publiques).
model Product {
  id         String   @id @default(uuid()) @db.Uuid
  barcode    String   @unique @db.VarChar(14)
  name       String   @db.VarChar(200)
  brand      String?  @db.VarChar(200)
  imageUrl   String?  @db.VarChar(500)
  category   String?  @db.VarChar(100)
  // Tous les tags de catégorie Open Food Facts (nettoyés, 30 au plus) : le premier tag, très
  // général ("en:snacks"), ne suffit pas pour suggérer une date de péremption.
  categories String[] @default([]) @db.VarChar(100)
  nutriscore String?  @db.Char(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pantryItems PantryItem[]
}

model PantryItem {
  id          String           @id @default(uuid()) @db.Uuid
  // Chaque article appartient à un foyer : toutes les requêtes seront filtrées par ce champ.
  householdId String           @db.Uuid
  // Optionnel : un article saisi à la main n'a pas de fiche produit.
  productId   String?          @db.Uuid
  // Le nom est toujours stocké ici (copié de la fiche produit ou saisi à la main).
  name        String           @db.VarChar(200)
  quantity    Int              @default(1)
  unit        QuantityUnit     @default(PIECE)
  // @db.Date : une date sans heure. "Périme le 20" ne doit pas dépendre d'un fuseau horaire.
  expiryDate  DateTime         @db.Date
  expiryType  ExpiryType
  status      PantryItemStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  // SetNull : si une fiche produit est supprimée du cache, l'article reste dans l'inventaire.
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Index taillé pour la requête principale : "les articles actifs de mon foyer, par date".
  @@index([householdId, status, expiryDate])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  // Une "famille" = une session (une connexion). Toutes les rotations d'une même connexion
  // partagent cet id : si un ancien token est réutilisé, on révoque toute la famille (4d).
  familyId  String    @db.Uuid
  // Empreinte SHA-256 du token, jamais le token : une fuite de la base ne donne aucune session.
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  // Rempli à la rotation ou à la déconnexion : un token révoqué n'est plus accepté.
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  // Cascade : supprimer un compte supprime toutes ses sessions.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// Alerte quotidienne d'un foyer : UNE par foyer et par jour, avec seulement des compteurs.
// La liste des produits concernés est relue dans l'inventaire (pas de donnée en double).
model Alert {
  id           String    @id @default(uuid()) @db.Uuid
  householdId  String    @db.Uuid
  // Jour de l'alerte (date sans heure, comme les dates de péremption).
  date         DateTime  @db.Date
  // DLC dépassée : à jeter.
  expiredCount Int
  // À consommer aujourd'hui ou dans les 2 jours, ou DDM dépassée.
  urgentCount  Int
  // Rempli quand l'utilisateur ferme le bandeau.
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  // Cascade : supprimer un foyer supprime ses alertes.
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  // Idempotence : la base refuse une deuxième alerte pour le même foyer le même jour,
  // même si la tâche planifiée s'exécute plusieurs fois.
  @@unique([householdId, date])
}

enum EmailTokenPurpose {
  EMAIL_VERIFICATION
  // Réservé au futur « mot de passe oublié » : même mécanisme, autre usage.
  PASSWORD_RESET
}

// Jeton envoyé par email (lien de vérification, plus tard de réinitialisation du mot de passe).
// Comme pour les sessions, seule l'empreinte SHA-256 est stockée : une fuite de la base ne donne
// aucun lien utilisable.
model EmailToken {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @db.Uuid
  purpose   EmailTokenPurpose
  tokenHash String            @unique @db.Char(64)
  expiresAt DateTime
  // Usage unique : rempli dès que le lien a servi.
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  // Cascade : supprimer un compte supprime ses jetons.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}
