# Nginx du front en production : sert l'application compilée (fichiers statiques).
# Le HTTPS et le HSTS sont gérés par le reverse proxy placé devant (seul à parler HTTPS).
# Les modèles (*.template) sont complétés à la construction de l'image (voir Dockerfile).

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Ne pas annoncer la version de Nginx (aide un attaquant à cibler une faille connue).
    server_tokens off;

    # Un site statique ne reçoit que des lectures : tout le reste est refusé d'emblée.
    if ($request_method !~ ^(GET|HEAD)$) {
        return 405;
    }

    gzip on;
    gzip_types text/css application/javascript application/manifest+json image/svg+xml;

    # Fichiers de build dont le nom contient une empreinte du contenu (index-3f9a1c.js) :
    # ils ne changent jamais, le navigateur peut les garder un an.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Service worker et manifeste : toujours revalidés, sinon une nouvelle version déployée
    # (correctif de sécurité compris) pourrait rester bloquée dans le navigateur.
    location ~ ^/(sw\.js|registerSW\.js|workbox-[^/]+\.js|manifest\.webmanifest)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # Application monopage : toute URL inconnue (/profile, /scan...) renvoie index.html,
    # React Router affiche ensuite la bonne page.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
